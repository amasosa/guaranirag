# Proveedor utilizado para generar las predicciones.
# Valores: OPENAI, GEMINI, GROQ, MISTRAL, DEEPSEEK o ANTHROPIC.
PROVIDER=ANTHROPIC

# OPENAI_API_KEY siempre es necesaria para la recuperación RAG.
OPENAI_API_KEY=

# Complete solamente la clave del proveedor seleccionado.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=

# Modelos opcionales. Modifíquelos si su cuenta utiliza otros nombres.
OPENAI_MODEL=gpt-5.2
GEMINI_MODEL=gemini-2.5-pro
GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-large-latest
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Rutas relativas a la carpeta del proyecto. También se aceptan rutas absolutas.
DEV_PATH=data/guarani-dev.tsv
TRAIN_PATH=data/guarani-train.tsv
GUARANI_TXT_PATH=data/guarani.txt
PERSIST_DIR=guarani_db
OUTPUT_DIR=resultados
